---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found">
    <p class="display-code">404</p>
    <h1>That page wandered off.</h1>
    <p>The page may have moved, or the address may be mistyped.</p>
    <a class="button" href="/">Back to the home page</a>
  </section>
</BaseLayout>
