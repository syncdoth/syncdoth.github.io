---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';

const research = await getEntry('pages', 'research');
if (!research) throw new Error('Missing src/content/pages/research.md');
const { Content } = await render(research);
---

<BaseLayout title="Research" description={research.data.description}>
  <PageHeading eyebrow="Research questions" title="Language models, grounded and general." description={research.data.description} />
  <article class="prose research-prose"><Content /></article>
  <section class="section" aria-labelledby="related-papers-title">
    <div class="section-heading">
      <div><p class="section-kicker">Related work</p><h2 id="related-papers-title">Selected publications</h2></div>
      <a class="text-link" href="/publications/">Full publication list →</a>
    </div>
    <PublicationList items={publications.filter((paper) => paper.selected)} />
  </section>
</BaseLayout>
