---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { education } from '../data/timeline';
---

<BaseLayout title="Education" description="Education history for Sehyun Choi.">
  <PageHeading eyebrow="Education" title="Learning and foundations" description="Academic history and selected milestones." />
  <section aria-label="Education history">
    <ol class="timeline-list">
      {education.map((item) => (
        <li class="timeline-item">
          <time class="timeline-date">{item.dates}</time>
          <div class="timeline-content">
            <h2>{item.degree}</h2>
            <p>{item.institution}</p>
            {item.detail && <p class="timeline-detail">{item.detail}</p>}
            {item.links && (
              <div class="link-row" style="margin-top: 0.55rem">
                {item.links.map((link) => <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="supporting-link"><a class="inline-link" href="/courseworks/">View coursework history →</a></p>
  </section>
</BaseLayout>
