---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getPublicBlogPosts } from '../lib/content';
import { publications } from '../data/publications';
import { education, experiences, news } from '../data/timeline';
import { externalWritings, profile, researchAreas, socialLinks } from '../data/site';
import WritingCard from '../components/WritingCard.astro';

const writingItems = [
  ...externalWritings.map((item) => ({ ...item, external: true })),
  ...(await getPublicBlogPosts()).map((post) => ({
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    href: `/blog/${post.data.pubDate.getFullYear()}/${post.id}/`,
    tags: post.data.tags.slice(0, 3),
    external: false,
  })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()).slice(0, 4);
const selectedPapers = publications.filter((publication) => publication.selected);
const recentExperience = experiences.slice(0, 3);
const recentNews = news.slice(0, 4);
---

<BaseLayout title="About">
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">Machine learning research · {profile.location}</p>
        <h1 id="home-title">Sehyun Choi</h1>
        <p class="role-line"><span class="status-dot" aria-hidden="true"></span>{profile.role}</p>
        <p class="hero-intro">{profile.introduction}</p>
        <div class="button-row">
          <a class="button" href="/research/">Explore research <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={profile.resume}>Résumé PDF <span aria-hidden="true">↓</span></a>
        </div>
        <nav class="hero-socials" aria-label="Find me online">
          {socialLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel={link.href.startsWith('mailto:') ? undefined : 'noreferrer'}>{link.label}{link.href.startsWith('mailto:') ? '' : ' ↗'}</a>
          ))}
        </nav>
      </div>
      <figure class="hero-visual">
        <div class="portrait-accent" aria-hidden="true"></div>
        <div class="portrait-frame">
          <img src={profile.photo} alt="Sehyun Choi at his HKUST graduation" fetchpriority="high" />
        </div>
        <figcaption class="portrait-caption"><span>Sehyun Choi</span><span>HKUST · 2022</span></figcaption>
      </figure>
    </section>

    <section class="focus-panel" aria-label="Current work">
      <p class="mono-label">Currently</p>
      <p>Researching multimodal LLMs at <a href="https://twelvelabs.io/" target="_blank" rel="noreferrer">TwelveLabs</a>. I'm interested in efficient (multi-modal) transfer learning, inference-time methods, knowledge grounding.</p>
    </section>

    <section class="section" aria-labelledby="interests-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Questions I work on</p>
          <h2 id="interests-title">Research interests</h2>
        </div>
      </div>
      <div class="interest-grid">
        {researchAreas.map((area) => (
          <article class="interest-card">
            <p class="mono-label">{area.number}</p>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <div class="interest-links" aria-label={`Related work for ${area.title}`}>
              {area.links.map((link) => (
                <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="selected-papers-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">A few selected works</p>
          <h2 id="selected-papers-title">Research</h2>
        </div>
        <a class="text-link" href="/publications/">All publications <span aria-hidden="true">→</span></a>
      </div>
      <PublicationList items={selectedPapers} />
    </section>

    <div class="section home-two-col">
      <section aria-labelledby="experience-preview-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Places and people</p>
            <h2 id="experience-preview-title">Experience</h2>
          </div>
          <a class="text-link" href="/experiences/">Full history <span aria-hidden="true">→</span></a>
        </div>
        <ol class="timeline-list">
          {recentExperience.map((item) => (
            <li class="timeline-item">
              <time class="timeline-date">{item.dates}</time>
              <div class="timeline-content">
                <h3><a href={item.organizationUrl} target="_blank" rel="noreferrer">{item.organization}</a></h3>
                <p>{item.role}{item.details ? ` · ${item.details}` : ''}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="supporting-link"><a class="inline-link" href="/education/">Education history →</a></p>
      </section>

      <section aria-labelledby="news-preview-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Recent updates</p>
            <h2 id="news-preview-title">News</h2>
          </div>
          <a class="text-link" href="/news/">All updates <span aria-hidden="true">→</span></a>
        </div>
        <ul class="news-list">
          {recentNews.map((item) => (
            <li>
              <time class="news-date">{item.date}</time>
              <p class="news-copy">{item.text} {item.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="section" aria-labelledby="writing-preview-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Notes from the lab and beyond</p>
          <h2 id="writing-preview-title">Writing</h2>
        </div>
        <a class="text-link" href="/blog/">All writing <span aria-hidden="true">→</span></a>
      </div>
      <div class="writing-list">
        {writingItems.map((item) => <WritingCard item={item} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="education-note-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">A little more context</p>
          <h2 id="education-note-title">Education</h2>
        </div>
        <a class="text-link" href="/education/">Full education <span aria-hidden="true">→</span></a>
      </div>
      <ol class="timeline-list">
        {education.slice(0, 2).map((item) => (
          <li class="timeline-item">
            <time class="timeline-date">{item.dates}</time>
            <div class="timeline-content">
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
              {item.detail && <p class="timeline-detail">{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p class="supporting-link"><a class="inline-link" href="/courseworks/">Coursework history →</a></p>
    </section>
  </div>
</BaseLayout>
