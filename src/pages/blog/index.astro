---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import WritingCard from '../../components/WritingCard.astro';
import { getPublicBlogPosts } from '../../lib/content';
import { externalWritings } from '../../data/site';

const writingItems = [
  ...externalWritings.map((item) => ({ ...item, external: true })),
  ...(await getPublicBlogPosts()).map((post) => ({
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    href: `/blog/${post.data.pubDate.getFullYear()}/${post.id}/`,
    tags: post.data.tags,
    external: false,
  })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
const years = [...new Set(writingItems.map((item) => item.pubDate.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout title="Writing" description="Notes and essays by Sehyun Choi on machine learning, language models, and related ideas.">
  <PageHeading eyebrow="Notes and essays" title="Writing" description="A collection of technical notes, research reflections, and ideas I wanted to work through in writing." />
  <div class="archive-years" aria-label="Browse writing by year">
    <span class="mono-label">Browse by year</span>
    {years.map((year) => <a class="text-link" href={`/blog/${year}/`}>{year}</a>)}
    <a class="text-link rss-link" href="/feed.xml">RSS ↗</a>
  </div>
  <section class="writing-list" aria-label="Writing">
    {writingItems.map((item) => <WritingCard item={item} />)}
  </section>
</BaseLayout>
