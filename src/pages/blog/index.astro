---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getPublicBlogPosts } from '../../lib/content';

const posts = (await getPublicBlogPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
---

<BaseLayout title="Writing" description="Notes and essays by Sehyun Choi on machine learning, language models, and related ideas.">
  <PageHeading eyebrow="Notes and essays" title="Writing" description="A collection of technical notes, research reflections, and ideas I wanted to work through in writing." />
  <div class="archive-years" aria-label="Browse writing by year">
    <span class="mono-label">Browse by year</span>
    {years.map((year) => <a class="text-link" href={`/blog/${year}/`}>{year}</a>)}
    <a class="text-link rss-link" href="/feed.xml">RSS ↗</a>
  </div>
  <section class="writing-list" aria-label="Blog posts">
    {posts.map((post) => (
      <article class="writing-card">
        <a href={`/blog/${post.data.pubDate.getFullYear()}/${post.id}/`}>
          <div class="writing-card-content">
            <div class="writing-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}</time></div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="tag-list">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
