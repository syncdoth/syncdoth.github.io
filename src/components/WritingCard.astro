---
interface Props {
  item: {
    title: string;
    description: string;
    pubDate: Date;
    href: string;
    source?: string;
    tags: string[];
    external: boolean;
  };
}

const { item } = Astro.props;
---

<article class="writing-card">
  <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
    <div class="writing-card-content">
      <div class="writing-meta">
        <time datetime={item.pubDate.toISOString()}>{item.pubDate.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        {item.source && <span>{item.source}</span>}
      </div>
      <h2>{item.title}</h2>
      <p>{item.description}</p>
      <div class="tag-list">{item.tags.map((tag) => <span>{tag}</span>)}</div>
    </div>
  </a>
</article>
