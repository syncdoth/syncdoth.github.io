---
import type { Publication } from '../data/publications';

interface Props {
  items: Publication[];
}

const { items } = Astro.props;
---

<ol class="publication-list">
  {items.map((publication) => (
    <li class="publication-item">
      <div class="publication-year">{publication.year}</div>
      <div class="publication-main">
        <div class="publication-heading">
          <h3>{publication.title}</h3>
          {publication.selected && <span class="pill pill-blue">Selected</span>}
        </div>
        <p class="publication-authors">
          {publication.authors.map((author, index) => (
            <>{author === 'Sehyun Choi' ? <strong>{author}</strong> : author}{index < publication.authors.length - 1 ? ', ' : ''}</>
          ))}
        </p>
        <p class="publication-venue">{publication.venue}</p>
        <div class="link-row">
          {publication.links.map((link) => (
            <a class="text-link" href={link.href} target={link.href.startsWith('/') ? undefined : '_blank'} rel={link.href.startsWith('/') ? undefined : 'noreferrer'}>
              {link.label}<span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
        {publication.abstract && (
          <details class="abstract-details">
            <summary>Abstract</summary>
            <p>{publication.abstract}</p>
          </details>
        )}
      </div>
    </li>
  ))}
</ol>
